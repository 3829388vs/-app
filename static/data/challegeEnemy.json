{"id":1003,"name":"牛魔王","gj":153,"fs":60,"fy":183,"mk":177,"gs":1.2,"v":1.2,"bj":0.3,"flz":1000,"distance": 80,"dis1": 100,"dis2": 2000,"dis3": 120,"dis4": 110,"speed": 0.85,"blood":12000,"heroBlood":3700,"icon":"niumo.jpg","level":1003,"levelNum": 3,
